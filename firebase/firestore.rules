rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/deletionRequests/$(uid));
    }
    function validProfile(data, uid) {
      return data.keys().hasAll(['uid', 'displayName', 'createdAt', 'updatedAt', 'version'])
        && data.keys().hasOnly(['uid', 'displayName', 'createdAt', 'updatedAt', 'version'])
        && data.uid == uid
        && data.displayName is string && data.displayName.size() <= 100
        && data.createdAt is timestamp && data.updatedAt is timestamp
        && data.updatedAt >= data.createdAt
        && data.version is int && data.version >= 1;
    }
    match /users/{uid} {
      allow get: if isOwner(uid);
      allow list, delete: if false;
      allow create: if isOwner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.version == 1;
      allow update: if isOwner(uid) && validProfile(request.resource.data, uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt >= resource.data.updatedAt
        && request.resource.data.version == resource.data.version + 1;
    }
    function validHistory(data, id) {
      return data.keys().hasOnly(['id','sessionID','projectID','projectName','categoryID','categoryName',
                                 'start','end','note','source','deleted','version','operationID'])
        && data.keys().hasAll(['id','sessionID','projectID','projectName','categoryID','categoryName',
                               'start','end','note','source','deleted','version','operationID'])
        && data.id == id && id.matches('[A-Za-z0-9_-]{1,128}')
        && data.sessionID is string && data.sessionID.matches('[A-Za-z0-9_-]{1,128}')
        && data.projectID is string && data.projectID.matches('[A-Za-z0-9_-]{1,128}')
        && data.categoryID is string && data.categoryID.matches('[A-Za-z0-9_-]{1,128}')
        && data.operationID is string && data.operationID.matches('[A-Za-z0-9_-]{1,128}')
        && data.projectName is string && data.projectName.size() > 0 && data.projectName.toUtf8().size() <= 16000
        && data.categoryName is string && data.categoryName.size() > 0 && data.categoryName.toUtf8().size() <= 16000
        && data.note is string && data.note.toUtf8().size() <= 32000
        && data.source in ['timer', 'manual'] && data.deleted is bool
        && data.start is number && data.end is number && data.start <= data.end
        && data.start >= -62135596800 && data.end < 253402300800
        && data.version is int && data.version >= 1;
    }
    match /users/{uid}/history/{id} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid) && validHistory(request.resource.data, id)
        && (!exists(/databases/$(database)/documents/users/$(uid)/history/$(id))
              ? request.resource.data.version == 1
              : request.resource.data.version == resource.data.version + 1
                && request.resource.data.sessionID == resource.data.sessionID)
        && !exists(/databases/$(database)/documents/users/$(uid)/historyOps/$(request.resource.data.operationID))
        && getAfter(/databases/$(database)/documents/users/$(uid)/historyOps/$(request.resource.data.operationID)).data.diff(request.resource.data).affectedKeys().hasOnly(['committedAt']);
      allow delete: if false;
    }
    match /users/{uid}/historyOps/{operationID} {
      allow read: if isOwner(uid);
      allow update, delete: if false;
      allow create: if isOwner(uid)
        && operationID.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.id is string && request.resource.data.id.matches('[A-Za-z0-9_-]{1,128}')
        && request.resource.data.operationID == operationID
        && request.resource.data.committedAt == request.time
        && request.resource.data.diff(getAfter(/databases/$(database)/documents/users/$(uid)/history/$(request.resource.data.id)).data).affectedKeys().hasOnly(['committedAt']);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
